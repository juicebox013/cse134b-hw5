  </weather-card>

  <noscript>
    <p>This weather card needs JavaScript to load live weather data.</p>
  </noscript>
</section>

<label for="feelings">How are you feeling about your tasks today?</label>
<br>

<textarea id="feelings" name="feelings" rows="5" cols="33">
I did not enjoy my tasks today.
</textarea>

<section>
  <h2>Today's Tasks</h2>

  <article class="task-box">
    <p>Placeholder text for task.</p>

    <fieldset>
      <legend>Is this task completed?</legend>

      <label for="task-completed">Completed.</label>
      <input type="checkbox" name="task-completed" id="task-completed">

      <label for="task-not-completed">Not Completed.</label>
      <input type="checkbox" name="task-not-completed" id="task-not-completed">
    </fieldset>
  </article>
</section>

<section>
  <h2>Overdue Tasks</h2>
  <article>
    <p>Placeholder text for task.</p>
  </article>
</section>

<section>
  <h2>Upcoming Tasks</h2>
  <article>
    <p>Placeholder text for task.</p>
  </article>
</section>

<section>
  <h2>Task Progress</h2>

  <p>Placeholder text for task.</p>

  <label for="task-progress">Task progress:</label>
  <progress id="task-progress" max="100" value="20">20%</progress>
</section>

<iframe
  src="/calendar-page/"
  width="600"
  height="400"
  title="Calendar page preview">
</iframe>

<template id="weather-card-template">
  <article class="weather-card">
    <h3 class="weather-card__title">Current weather</h3>
    <p class="weather-card__status"></p>

    <dl class="weather-card__data" hidden>
      <dt>Temperature</dt>
      <dd class="weather-card__temperature"></dd>

      <dt>Wind speed</dt>
      <dd class="weather-card__wind"></dd>
    </dl>

    <p class="weather-card__source">
      Data from Open-Meteo.
    </p>
  </article>
</template>

<picture>
  <source srcset="/images/big-bird.png" media="(width >= 600px)">
